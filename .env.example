# OLLAMA_BASE_URL: The URL where your Ollama instance is running.
# Defaults to http://localhost:11434 if not set.
OLLAMA_BASE_URL="http://localhost:11434"

# DEFAULT_OLLAMA_MODEL: Optional default model to use when none is selected.
# If not set, the first available model from Ollama will be used.
# DEFAULT_OLLAMA_MODEL="llama3"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
